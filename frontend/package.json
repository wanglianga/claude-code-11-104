{
  "name": "simswap-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke:ui": "esbuild smoke/smoke.tsx --bundle --platform=node --format=esm --outfile=smoke/smoke.mjs --jsx=automatic --external:jsdom --loader:.css=empty --log-level=warning && node smoke/smoke.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
